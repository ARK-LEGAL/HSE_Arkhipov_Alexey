def fib(n):
    if n <= 0:
        return 0
    result = [1, 1]
    for _ in range(2, n):
        result.append(result[-2] + result[-1])
    return result[:n] # slice is for n <= 2 to be correct

def fib_gen(n):
    if n <= 0:
        return 0
    a, b = 1, 1
    for _ in range(n):
        yield a
        a, b = b, a + b
