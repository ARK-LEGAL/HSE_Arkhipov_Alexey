def roman_to_int(s: str) -> int:
    values = {'I': 1, 'V': 5, 'X': 10, 'L': 50, 'C': 100, 'D': 500, 'M': 1000}
    subs = {'I': ('V', 'X'), 'X': ('L', 'C'), 'C': ('D', 'M')}
    result = 0
    s = s.upper()
    for i, char in enumerate(s):
        v = values[char]
        if char in subs and i + 1 < len(s) and v < values[s[i + 1]]:
            if s[i + 1] in subs[char]:
                result -= v
            else:
                return "invalid roman"
        else:
            result += v
    return result
